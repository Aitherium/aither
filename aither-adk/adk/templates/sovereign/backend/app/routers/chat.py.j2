"""Chat endpoint — RAG-augmented conversation."""

from __future__ import annotations

import logging
import re
import uuid
from collections import OrderedDict

from fastapi import APIRouter, Depends, Request
from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from ..auth import UserContext, get_user_context
from ..config import settings
from ..database import get_db
from ..models import ChatRequest, ChatResponse, ConversationRecord, LLMUsage
from ..services import llm, rag

log = logging.getLogger("{{ log_name }}.chat")
_THINK_RE = re.compile(r"<think>.*?</think>\s*", re.DOTALL)

router = APIRouter(prefix="/api/chat", tags=["chat"])

_MAX_CACHE = 64
_cache: OrderedDict[tuple[str, str], list[dict]] = OrderedDict()


def _cache_get(tenant_id: str, conv_id: str) -> list[dict] | None:
    key = (tenant_id, conv_id)
    if key in _cache:
        _cache.move_to_end(key)
        return _cache[key]
    return None


def _cache_put(tenant_id: str, conv_id: str, history: list[dict]):
    key = (tenant_id, conv_id)
    _cache[key] = history
    _cache.move_to_end(key)
    while len(_cache) > _MAX_CACHE:
        _cache.popitem(last=False)


@router.get("/conversations")
async def list_conversations(
    user: UserContext = Depends(get_user_context),
    db: AsyncSession = Depends(get_db),
):
    result = await db.execute(
        select(
            ConversationRecord.conversation_id,
            ConversationRecord.title,
            ConversationRecord.user_id,
            ConversationRecord.visibility,
            func.min(ConversationRecord.created_at).label("started_at"),
            func.count(ConversationRecord.id).label("message_count"),
        )
        .where(ConversationRecord.tenant_id == user.tenant_id)
        .group_by(
            ConversationRecord.conversation_id,
            ConversationRecord.title,
            ConversationRecord.user_id,
            ConversationRecord.visibility,
        )
        .order_by(func.max(ConversationRecord.created_at).desc())
        .limit(50)
    )
    return [
        {
            "conversation_id": r.conversation_id,
            "title": r.title or "(untitled)",
            "started_by": r.user_id,
            "visibility": r.visibility,
            "started_at": r.started_at.isoformat() if r.started_at else None,
            "message_count": r.message_count,
        }
        for r in result.all()
    ]


@router.post("", response_model=ChatResponse)
async def chat_endpoint(
    req: ChatRequest,
    user: UserContext = Depends(get_user_context),
    db: AsyncSession = Depends(get_db),
):
    conv_id = req.conversation_id or str(uuid.uuid4())

    try:
        context = rag.search(req.message, tenant_id=user.tenant_id)
    except Exception as e:
        log.warning("RAG search failed (non-fatal): %s", e)
        context = []

    # Load conversation history
    history = _cache_get(user.tenant_id, conv_id)
    if history is None:
        result = await db.execute(
            select(ConversationRecord)
            .where(
                ConversationRecord.conversation_id == conv_id,
                ConversationRecord.tenant_id == user.tenant_id,
            )
            .order_by(ConversationRecord.created_at.asc())
        )
        rows = result.scalars().all()
        history = [{"role": r.role, "content": r.content} for r in rows]

    llm_result = await llm.chat(
        user_message=req.message,
        context_chunks=context,
        conversation_history=history[-10:],
    )
    response_text = llm_result.text

    title = req.message[:60] + "..." if len(req.message) > 60 else req.message

    db.add(ConversationRecord(
        conversation_id=conv_id, role="user", content=req.message,
        tenant_id=user.tenant_id, user_id=user.user_id, title=title, visibility="shared",
    ))
    db.add(ConversationRecord(
        conversation_id=conv_id, role="assistant", content=response_text,
        tenant_id=user.tenant_id, user_id="{{ agent_name }}", title=title, visibility="shared",
    ))
    await db.commit()

    history.append({"role": "user", "content": req.message})
    history.append({"role": "assistant", "content": response_text})
    _cache_put(user.tenant_id, conv_id, history)

    sources = [
        {"filename": c["filename"], "score": round(c.get("score", 0), 3)}
        for c in context
    ] if context else []

    return ChatResponse(
        message_id=str(uuid.uuid4()),
        response=response_text,
        sources=sources,
        conversation_id=conv_id,
        usage=LLMUsage(**llm_result.to_dict()),
    )
